# Generated training output, arbitrary model weights, and temporary archives
# remain local. The approved runtime bundle and curated port dataset are
# explicitly versioned in private Git LFS below.
models/
*.pt
*.onnx
*.engine
*.weights
training/datasets/
training/runs/
runs/
cloud_training/*.zip

# Safe, portable project assets tracked in this private repository.
!models/
!models/**
!models/**/*.pt
!models/**/*.onnx
!models/**/*.engine
!models/**/*.weights
!training/
!training/datasets/
!training/datasets/port/
!training/datasets/port/**
