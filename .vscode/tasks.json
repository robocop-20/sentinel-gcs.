{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Sentinel: Connect C Frontend to D Backend",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\connect_c_frontend_to_d_backend.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "focus": false, "panel": "dedicated", "clear": true, "showReuseMessage": false },
            "runOptions": { "instanceLimit": 1 },
            "problemMatcher": []
        },
        {
            "label": "Sentinel: Repair and Start Complete D Stack",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\repair_and_start_d_stack.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "focus": false, "panel": "dedicated", "clear": true },
            "runOptions": { "instanceLimit": 1 },
            "problemMatcher": []
        },
        {
            "label": "Sentinel: Deploy Complete Backend to D",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\deploy_backend_to_d.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "focus": false, "panel": "dedicated", "clear": true },
            "runOptions": { "instanceLimit": 1 },
            "problemMatcher": []
        },
        {
            "label": "Sentinel: Change D Camera IP",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\set_d_camera_ip.ps1", "-Source", "${input:cameraSource}"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Sentinel: Diagnose D Stack",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\diagnose_d_stack.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "focus": false, "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Sentinel: Set D Operator Password",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\set_d_operator_password.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Sentinel: Change D Operator Username and Password",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\set_d_operator_credentials.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
            "problemMatcher": []
        }
    ],
    "inputs": [
        { "id": "cameraSource", "type": "promptString", "description": "New phone/camera IP:port or complete stream URL" }
    ]
}
