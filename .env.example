API_PORT=8080
TLS_API_PORT=8443
OPS_PROMETHEUS_PORT=9090
OPS_ALERTMANAGER_PORT=9093
OPS_GRAFANA_PORT=3001
LOG_LEVEL=INFO
SERVICE_HEALTH_PORT=8091
CORS_ORIGINS=https://127.0.0.1:8443,https://localhost:8443
AUTH_ENABLED=false
AUTH_ISSUER=sentinel-ground-station
AUTH_AUDIENCE=sentinel-api
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_SIGNING_KEY_FILE=/run/secrets/jwt-signing-key
AUTH_USERS_FILE=/run/secrets/auth-users.json
AUTH_SERVICE_CREDENTIALS_FILE=/run/secrets/service-credentials.json
REQUEST_BODY_LIMIT_BYTES=2500000
API_RATE_LIMIT_PER_MINUTE=240
SERVICE_RATE_LIMIT_PER_MINUTE=1800
PREVIEW_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=10
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-a-unique-random-password
DATABASE_URL=postgresql://sentinel:replace-with-the-same-password@postgis:5432/sentinel
MQTT_HOST=mqtt
MQTT_PORT=8883
CAMERA_FOV_HORIZONTAL_DEG=92
CAMERA_FOV_VERTICAL_DEG=60
CAMERA_MOUNT_PITCH_DEG=-90
CAMERA_FX_PX=0
CAMERA_FY_PX=0
CAMERA_CX_PX=0
CAMERA_CY_PX=0
CAMERA_CALIBRATION_FILE=
CAMERA_EXTRINSICS_FILE=
ENABLE_RAY_PLANE_GEOLOCATION=false
CAMERA_TO_BODY_MATRIX=0,-1,0,1,0,0,0,0,1
LIDAR_MAX_AGE_S=1.5
LIDAR_ORIENTATION=downward
TELEMETRY_MAX_SKEW_S=1.0
PIPELINE_QUEUE_SIZE=512
FAILSAFE_MAX_QUEUE_RATIO=0.80
DURABLE_QUEUE_PATH=/var/lib/sentinel/durable-queue.sqlite3
DURABLE_QUEUE_MAX_RECORDS=100000
DURABLE_QUEUE_MAX_BYTES=536870912
DELIVERY_RETRY_BASE_S=0.5
DELIVERY_RETRY_MAX_S=60
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_CIRCUIT_FAILURE_THRESHOLD=5
DELIVERY_CIRCUIT_COOLDOWN_S=15
DETECTION_IDEMPOTENCY_TTL_S=120
EVENT_IDEMPOTENCY_WINDOW_S=30
V2X_IDEMPOTENCY_TTL_S=3600
# The host camera URL lives only in config/camera-source.txt.
MJPEG_BRIDGE_TOKEN=replace-with-a-random-32-byte-token
VISION_VIDEO_SOURCE=http://host.docker.internal:8090/videofeed?token=replace-with-the-same-token
VIDEO_BACKEND=
VIDEO_ROTATION_DEG=0
CAMERA_ID=camera-01
CAMERA_VEHICLE_ID=
WEBSOCKET_MAX_CLIENTS=32
YOLO_MODEL=/models/yolo11s.pt
YOLO_DEVICE=
DETECTION_CONFIDENCE=0.35
PERSON_CANDIDATE_CONFIDENCE=0.25
VESSEL_CANDIDATE_CONFIDENCE=0.20
VEHICLE_CANDIDATE_CONFIDENCE=0.20
CONTAINER_CANDIDATE_CONFIDENCE=0.25
OBJECT_PUBLISH_CONFIDENCE=0.35
PERSON_PUBLISH_CONFIDENCE=0.55
VESSEL_PUBLISH_CONFIDENCE=0.35
VEHICLE_PUBLISH_CONFIDENCE=0.40
CONTAINER_PUBLISH_CONFIDENCE=0.50
FRAME_INTERVAL=1
VISION_IMG_SIZE=640
VISION_MAX_DETECTIONS=100
VISION_RECONNECT_DELAY_S=0.5
VISION_RECONNECT_MAX_DELAY_S=15
VISION_STATUS_INTERVAL_S=2
VISION_METRICS_STALE_S=8
VISION_API_TIMEOUT_S=1
VISION_CPU_THREADS=0
ENABLE_ANNOTATED_PREVIEW=true
PREVIEW_FPS=5
PREVIEW_MAX_DIMENSION_PX=960
PREVIEW_JPEG_QUALITY=80
# Higher alpha reacts faster; lower alpha is smoother. Raw YOLO confidence is unchanged.
CONFIDENCE_DISPLAY_EMA_ALPHA=0.25
CONFIDENCE_TRACK_TTL_S=30
TARGET_OBJECT_CLASSES=person,boat,vessel,car,truck,bus,motorcycle,container,shipping_container,vehicle
MOTION_MOVING_THRESHOLD_PX_S=15
MOTION_TRACK_TTL_S=3
MIN_TRACK_CONFIRMATION_FRAMES=5
PERSON_CONFIRMATION_FRAMES=5
VESSEL_CONFIRMATION_FRAMES=3
VEHICLE_CONFIRMATION_FRAMES=3
CONTAINER_CONFIRMATION_FRAMES=4
TRACK_CONFIRMATION_MAX_GAP_S=1.5
TRACK_EVIDENCE_WINDOW=8
TRACK_MIN_CLASS_STABILITY=0.80
PERSON_TRACK_MIN_MEAN_CONFIDENCE=0.62
OBJECT_TRACK_MIN_MEAN_CONFIDENCE=0.50
VESSEL_TRACK_MIN_MEAN_CONFIDENCE=0.50
VEHICLE_TRACK_MIN_MEAN_CONFIDENCE=0.52
CONTAINER_TRACK_MIN_MEAN_CONFIDENCE=0.58
ACTIVE_TRACK_TTL_S=8
TRACK_OCCLUDED_AFTER_S=0.75
TRACK_TEMPORARILY_LOST_AFTER_S=2.0
TRACK_REACQUIRED_AFTER_S=0.75
MODEL_MANIFEST_PATH=
REQUIRE_MODEL_MANIFEST=false
ENABLE_FACE_DETECTION=false
FACE_DETECTION_INTERVAL=3
FACE_DETECTION_MAX_DIMENSION_PX=640
FACE_DETECTOR_MODEL_PATH=/models/face/yunet.onnx
FACE_QUALITY_MIN_SCORE=0.65
ENABLE_BEHAVIOR_ANALYTICS=true
LOITER_WINDOW_S=120
LOITER_RADIUS_M=8
PROXIMITY_WARNING_DISTANCE_M=8
BEHAVIOR_EVENT_COOLDOWN_S=300
BEHAVIOR_TRACK_TTL_S=900
FACE_DETECTION_CONFIDENCE=0.65
PRIVACY_BLUR_FACES=true
MAVLINK_ENDPOINT=udp:0.0.0.0:14550
MAVLINK_BAUD=57600
RISK_TIMEZONE=Asia/Kolkata
RISK_QUIET_START_HOUR=20
RISK_QUIET_END_HOUR=6
ENABLE_V2X=false
V2X_SOURCE_ID=ground-station-01
V2X_ALLOWED_SOURCES=drone-01,camera-01,vehicle-01,infrastructure-01
V2X_SHARED_SECRET=
V2X_EVENTS_TOPIC=sentinel/v2x/events
V2X_HEARTBEATS_TOPIC=sentinel/v2x/heartbeats
V2X_MAX_AGE_S=30
V2X_HEARTBEAT_INTERVAL_S=5
V2X_DEVICE_OFFLINE_S=15
# Production V2X transport: use a broker/gateway with per-device credentials and mTLS.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_RECONNECT_MIN_S=1
MQTT_RECONNECT_MAX_S=30
MQTT_PUBLISH_TIMEOUT_S=5
MQTT_DEAD_LETTER_TOPIC=sentinel/dead-letter/events
DATABASE_WRITE_POOL_SIZE=4
DATABASE_READ_POOL_SIZE=4
HISTORY_QUERY_MAX_RECORDS=2000
HISTORY_QUERY_MAX_SPAN_S=86400
# Deterministic telemetry/V2X integrity monitoring (advisory only).
ENABLE_SECURITY_MONITOR=true
SECURITY_MONITOR_INTERVAL_S=1
SECURITY_TELEMETRY_STALE_S=5
SECURITY_MAX_CLOCK_SKEW_S=3
SECURITY_MAX_GROUND_SPEED_MPS=70
SECURITY_MAX_HEADING_RATE_DEG_S=540
SECURITY_LIDAR_ALTITUDE_DELTA_M=8
SECURITY_LEVEL_ATTITUDE_DEG=15
SECURITY_MIN_LINK_QUALITY_PERCENT=20
SECURITY_FINDING_COOLDOWN_S=30
SECURITY_FINDINGS_TOPIC=ground/security/findings
SECURITY_ADVISORIES_TOPIC=ground/security/advisories
# Set true only after MQTT TLS is configured at the broker and clients.
MQTT_TLS_ENABLED=true
ENABLE_LLM_VERIFICATION=false
LLM_VERIFICATION_MIN_RISK=75
EVIDENCE_REQUEST_TTL_S=60
# Comma-separated additional IP camera/drone IDs for advisory evidence requests.
EVIDENCE_CAMERA_IDS=
EVIDENCE_REQUESTS_TOPIC=ground/evidence/requests
# Disabled by default: this writes immutable encrypted non-person object crops.
# Face crops are never written by this layer.
ENABLE_EVIDENCE_CAPTURE=false
EVIDENCE_DIR=/evidence
EVIDENCE_ENCRYPTION_KEY_FILE=/run/secrets/evidence-encryption-key
EVIDENCE_CAPTURE_INTERVAL_S=2
EVIDENCE_MAX_DIMENSION_PX=640
EVIDENCE_JPEG_QUALITY=85
ENABLE_EVIDENCE_RETENTION=true
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_RETENTION_INTERVAL_S=3600
# OpenRouter's free router is suitable only for low-volume advisory review.
# Grok requires an operator-funded xAI API key; it is not face identification.
# Supply your own key locally; never commit it or copy this value to a message.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openrouter/free
# Keep false until an authorised operator explicitly approves image egress.
ENABLE_EXTERNAL_LLM_EGRESS=false
LLM_REQUEST_TIMEOUT_S=20
LLM_MAX_IMAGE_BYTES=1000000
LLM_MAX_QUEUE=16
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=1
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_S=60
# Separate consent gate for sanitised text-only security summaries. It never
# sends image/face data, raw telemetry packets, GPS coordinates, or credentials.
ENABLE_LLM_SECURITY_ADVISORY=false
ENABLE_EXTERNAL_LLM_TEXT_EGRESS=false
# To use Grok instead: LLM_PROVIDER=xai, LLM_MODEL=grok-4.5, XAI_API_KEY=...
# To use Gemini: LLM_PROVIDER=google, LLM_MODEL=gemini-3.6-flash, GEMINI_API_KEY=...
# Browser map tiles. Use the standard OSM endpoint only for normal interactive
# viewing; do not prefetch or bulk-download. A commissioned deployment can use
# a same-origin/self-hosted provider by changing this one value.
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Operator-requested external panorama. Google Maps URLs do not require an API
# key; only the selected latitude/longitude is sent when the operator clicks.
STREET_VIEW_URL_TEMPLATE=https://www.google.com/maps/@?api=1&map_action=pano&viewpoint={lat}%2C{lon}
